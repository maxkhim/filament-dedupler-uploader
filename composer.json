{
  "name": "maxkhim/filament-dedupler-uploader",
  "description": "Plugin for uploading and automatic deduplication files in Filament",
  "license": "MIT",
  "keywords": [
    "laravel",
    "filament",
    "filamentphp",
    "filament-plugin",
    "filament-dedupler-uploader",
    "dedupler"
  ],
  "homepage": "https://github.com/maxkhim/filament-dedupler-uploader",
  "support": {
    "issues": "https://github.com/maxkhim/filament-dedupler-uploader/issues",
    "source": "https://github.com/maxkhim/filament-dedupler-uploader"
  },
  "authors": [
    {
      "name": "Khimusov Maxim",
      "email": "maxkhim@yandex.ru",
      "role": "Creator"
    }
  ],
  "require": {
    "php": "^8.1",
    "maxkhim/laravel-storage-dedupler": "^1.0",
    "filament/filament": "^4.0 || ^5.0",
    "spatie/laravel-package-tools": "^1.15.0"
  },
  "autoload": {
    "psr-4": {
      "Maxkhim\\FilamentDeduplerUploader\\": "src"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Maxkhim\\FilamentDeduplerUploader\\Providers\\FilamentDeduplerUploaderServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}